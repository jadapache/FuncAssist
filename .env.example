HOST=127.0.0.1
PORT=6728
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:6728
SECRET_KEY=
PBKDF2_SALT=

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/funcAssist

# Redis Cache URL
REDIS_URL=redis://localhost:6379

# Knowledge Base documents storage volume (container mount path)
KNOWLEDGE_DATA_DIR=/app/knowledge_data

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://127.0.0.1:6728/api/integrations/jira/callback
# Optional space-separated scopes, e.g. read:jira-user read:sprint:jira-software read:board-scope:jira-software
JIRA_OAUTH_EXTRA_SCOPES=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:6728/api/integrations/github/callback

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://127.0.0.1:6728/api/integrations/gitlab/callback
GITLAB_BASE_URL=https://gitlab.com
