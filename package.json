{
  "name": "funcassist",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && .venv/Scripts/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "tauri": "tauri",
    "set-version": "node scripts/set-version.js",
    "install:all": "npm --prefix frontend install && cd backend && python -m venv .venv && .venv/Scripts/pip install -r requirements.txt"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5"
  }
}