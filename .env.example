GHCR_OWNER=your-github-owner
APP_VERSION=latest
APP_PORT=6728
# HTTPS: put tls.crt (certificate + intermediate chain) and tls.key in TLS_CERT_DIR and the
# frontend serves https://<server>:APP_HTTPS_PORT (port 80 then only redirects).
# In-browser models (WebGPU) only work over HTTPS. See docs/DEPLOY_HTTPS.md.
APP_HTTPS_PORT=6729
TLS_CERT_DIR=./certs
# Public URL of the app (use the https:// address once HTTPS is enabled).
FRONTEND_URL=http://localhost:6728
POSTGRES_USER=funcassist
POSTGRES_DB=funcassist
