HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
SECRET_KEY=
PBKDF2_SALT=

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/qa_mgmt

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/jira/callback
# Optional space-separated scopes, e.g. read:jira-user read:sprint:jira-software read:board-scope:jira-software
JIRA_OAUTH_EXTRA_SCOPES=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/github/callback

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gitlab/callback
GITLAB_BASE_URL=https://gitlab.com

# AI providers (also configurable in Settings UI)
# On live hosting use openai or anthropic — Ollama is for local machines only.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
