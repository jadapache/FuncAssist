FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY apps/web-angular/package.json apps/web-angular/package-lock.json ./apps/web-angular/
RUN npm ci --prefix apps/web-angular
COPY apps/web-angular/ ./apps/web-angular/
RUN npm run build --prefix apps/web-angular

FROM nginx:1.29-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web-angular/dist/web-angular/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/healthz || exit 1

